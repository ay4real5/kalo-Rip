generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  instructor    Instructor?
  customer      Customer?

  @@map("users")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  CUSTOMER
}

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postcode        String
  transmission    Transmission @default(MANUAL)
  experienceLevel ExperienceLevel @default(BEGINNER)
  preferredDays   Int[]    @map("preferred_days")
  preferredTimes  String?  @map("preferred_times")
  notes           String?
  smsOptIn        Boolean  @default(true) @map("sms_opt_in")
  emailOptIn      Boolean  @default(true) @map("email_opt_in")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bookings        Booking[]
  calls           CallLog[]
  waitlistEntries WaitlistEntry[]

  @@map("customers")
}

enum Transmission {
  MANUAL
  AUTOMATIC
  BOTH
}

enum ExperienceLevel {
  BEGINNER
  SOME_EXPERIENCE
  TEST_READY
  REFRESHER
}

model Instructor {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String?
  phone               String?
  vehicleType         String?  @map("vehicle_type")
  transmission        Transmission @default(MANUAL)
  basePostcode        String   @map("base_postcode")
  servicePostcodes    String[] @map("service_postcodes")
  lessonDurationMinutes Int    @default(60) @map("lesson_duration_minutes")
  travelBufferMinutes Int    @default(15) @map("travel_buffer_minutes")
  maxLessonsPerDay    Int     @default(6) @map("max_lessons_per_day")
  hourlyRatePence     Int     @default(3500) @map("hourly_rate_pence")
  acceptsNewLearners  Boolean @default(true) @map("accepts_new_learners")
  offersIntensive     Boolean @default(false) @map("offers_intensive")
  active              Boolean @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  availability      Availability[]
  blackoutDates     BlackoutDate[]
  bookings          Booking[]
  scheduleOverrides ScheduleOverride[]
  reviews           Review[]
  waitlistEntries   WaitlistEntry[]

  @@map("instructors")
}

model Availability {
  id            String   @id @default(cuid())
  instructorId  String   @map("instructor_id")
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  dayOfWeek     Int      @map("day_of_week")
  startTime     String   @map("start_time")
  endTime       String   @map("end_time")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([instructorId, dayOfWeek, startTime])
  @@map("availability")
}

model BlackoutDate {
  id            String   @id @default(cuid())
  instructorId  String   @map("instructor_id")
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("blackout_dates")
}

model ScheduleOverride {
  id            String   @id @default(cuid())
  instructorId  String   @map("instructor_id")
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  startTime     String?  @map("start_time")
  endTime       String?  @map("end_time")
  isAvailable   Boolean  @default(false) @map("is_available")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("schedule_overrides")
}

model Booking {
  id            String        @id @default(cuid())
  customerId    String        @map("customer_id")
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  instructorId  String        @map("instructor_id")
  instructor    Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  startsAt      DateTime      @map("starts_at")
  endsAt        DateTime      @map("ends_at")
  status        BookingStatus @default(CONFIRMED)
  pricePence    Int           @map("price_pence")
  lessonType    LessonType    @default(REGULAR) @map("lesson_type")
  notes         String?
  source        BookingSource @default(PHONE_AI)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  cancellationReason String?  @map("cancellation_reason")
  paidAt        DateTime?     @map("paid_at")
  paymentReference String?    @map("payment_reference")
  review        Review?

  // Availability search scans an instructor's diary over a date window on
  // every enquiry; the reminder cron and admin list scan by date and status.
  @@index([instructorId, startsAt])
  @@index([customerId, startsAt])
  @@index([status, startsAt])
  // Overlapping CONFIRMED bookings are additionally blocked by an exclusion
  // constraint that Prisma's schema language can't express — see
  // migrations/20260802150000_prevent_double_booking. Do not rely on application
  // checks alone; they race.
  @@map("bookings")
}

/// A learner waiting for a slot that isn't currently free. When a booking is
/// cancelled the freed slot is matched against these and the earliest-joined
/// matching learners are texted, so cancellations refill instead of being lost.
model WaitlistEntry {
  id            String         @id @default(cuid())
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Null means "any instructor who covers me".
  instructorId  String?        @map("instructor_id")
  instructor    Instructor?    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  earliestDate  DateTime       @map("earliest_date")
  latestDate    DateTime       @map("latest_date")
  /// Optional wall-clock preference in UK local time, e.g. "17:00".
  earliestTime  String?        @map("earliest_time")
  latestTime    String?        @map("latest_time")
  status        WaitlistStatus @default(ACTIVE)
  notifiedAt    DateTime?      @map("notified_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status, instructorId])
  @@index([customerId])
  @@map("waitlist_entries")
}

enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  CONVERTED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LessonType {
  REGULAR
  INTENSIVE
  TEST
  REFRESHER
}

enum BookingSource {
  PHONE_AI
  PORTAL
  ADMIN
}

model SlotHold {
  id            String   @id @default(cuid())
  instructorId  String @map("instructor_id")
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  customerPhone String? @map("customer_phone")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([instructorId, startsAt])
  @@map("slot_holds")
}

model CallLog {
  id              String   @id @default(cuid())
  twilioSid       String?  @unique @map("twilio_sid")
  customerId      String?  @map("customer_id")
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  fromNumber      String   @map("from_number")
  toNumber        String   @map("to_number")
  status          CallStatus @default(IN_PROGRESS)
  startedAt       DateTime @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  transcript      String?
  summary         String?
  handoffReason   String?  @map("handoff_reason")
  bookingId       String?  @map("booking_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("call_logs")
}

enum CallStatus {
  IN_PROGRESS
  HANDED_OFF
  COMPLETED
  FAILED
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique @map("booking_id")
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  instructorId String   @map("instructor_id")
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

enum LessonPackageType {
  SINGLE
  BLOCK_5
  BLOCK_10
  INTENSIVE
}

model LessonPackage {
  id            String   @id @default(cuid())
  name          String
  description   String?
  type          LessonPackageType @default(SINGLE)
  lessonCount   Int      @default(1)
  pricePence    Int      @map("price_pence")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("lesson_packages")
}
